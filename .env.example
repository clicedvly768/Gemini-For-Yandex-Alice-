# Настройки сервера
HOST=0.0.0.0
PORT=8080

# Google Gemini API
# Получите бесплатный API ключ на: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Spotify Web API
# Создайте приложение на: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Redirect URI для авторизации (должен совпадать с указанным в Spotify Dashboard)
# Например, если локально: http://localhost:8080/auth/callback
# Если через ngrok/туннель: https://your-domain.ngrok-free.app/auth/callback
SPOTIFY_REDIRECT_URI=http://localhost:8080/auth/callback

# (Опционально) Refresh token будет сохранен автоматически после перехода по /auth/login
# SPOTIFY_REFRESH_TOKEN=
